<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
        Make a room.

        The map list is hardcoded because the server does not expose one — RoomMaps.ByMap exists but
        no endpoint serves it. Getting it wrong is not silent: POST /rooms answers 400 unknownMap and
        that becomes SessionFailureKind.UnknownMap on screen.
    -->
    <ui:VisualElement name="create-room-popup" class="popup-frame">
        <ui:Label class="popup-title" text="방 만들기" />
        <ui:Label class="popup-sub" text="CREATE ROOM" />

        <ui:Label class="field-label" text="MAP" />
        <ui:DropdownField name="create-map" class="field" />
        <ui:Label name="create-map-note" class="hint" />

        <!--
            공개 여부는 만든 뒤에 바꿀 수 없다. 비공개인 줄 알고 코드를 나눈 방이
            나중에 목록에 뜨는 일이 없어야 하기 때문이다. 그래서 여기가 유일한 선택
            지점이고, 기본값은 비공개다 — 노출은 선택이지 기본값이 아니다.
        -->
        <ui:Label class="field-label" text="VISIBILITY" />
        <ui:Toggle name="create-public" label="공개 방으로 만든다" />
        <ui:Label name="create-public-note" class="hint" />

        <ui:VisualElement class="row">
            <ui:Button name="create-confirm" class="button button-primary" text="만들기" />
            <ui:Button name="create-cancel" class="button" text="취소" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
