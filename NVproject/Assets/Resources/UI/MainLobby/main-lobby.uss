/*
    Backrooms Escape — main lobby style.

    Same palette as game-hud.uss and the old lobby.uss, for the same reason: this is the first
    thing anyone sees, and if it reads as a game menu the level's mood restarts from zero when the
    match begins. Wall #C9B36B, trim #A8924E, fluorescent #FFF6D6, bone #F2E7C2, brown-black #0E0C08.

    Two rules carried over:
    - Nothing is pure white or pure black. Pure values read as software; these read as signage.
    - Panels are translucent, thin-bordered, square. Facility labelling, not a game overlay.

    One rule of its own: the invite code is *read aloud and typed by someone else*, so anywhere a
    code appears it is oversized and letter-spaced wide enough that no two characters run together.
*/

.lobby-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(24, 21, 14);
    flex-direction: column;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 28px;
    padding-bottom: 20px;
}

.bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(201, 179, 107, 0.03);
}

.scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.16;
    /* texture generated at runtime to match the screen height, so the lines stay one pixel */
}

/* ============================================================ header */

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom-width: 1px;
    border-bottom-color: rgb(78, 68, 40);
    padding-bottom: 14px;
}

.logo-title {
    color: rgb(255, 246, 214);
    font-size: 26px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgb(14, 12, 8);
}

.logo-sub {
    color: rgb(168, 146, 78);
    font-size: 10px;
    letter-spacing: 4px;
    margin-top: 2px;
}

.header-right {
    flex-direction: row;
    align-items: flex-start;
}

.player-info-slot {
    margin-right: 22px;
}

/* ============================================================ player info */

.player-info {
    flex-direction: column;
    align-items: flex-end;
}

.player-name {
    color: rgb(242, 231, 194);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.player-note {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 2px;
    margin-top: 2px;
}

/* ============================================================ connection */

.connection {
    flex-direction: column;
    align-items: flex-end;
}

.connection-line {
    flex-direction: row;
    align-items: center;
}

.connection-dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    background-color: rgb(120, 104, 58);
}

.connection-label {
    color: rgb(242, 231, 194);
    font-size: 12px;
    letter-spacing: 2px;
}

.connection-meta {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 1px;
    margin-top: 3px;
}

.connection-online .connection-dot {
    background-color: rgb(150, 196, 120);
}

.connection-offline .connection-dot {
    background-color: rgb(214, 108, 96);
}

.connection-offline .connection-label {
    color: rgb(214, 108, 96);
}

/* ============================================================ content */

.content-grid {
    flex-grow: 1;
    flex-direction: row;
    margin-top: 18px;
}

/* 친구 · 파티가 들어올 자리. 비어 있는 동안 폭을 먹지 않는다. */
.side-rail {
    width: 0;
}

.panel {
    background-color: rgba(14, 12, 8, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(168, 146, 78);
    border-right-color: rgb(168, 146, 78);
    border-top-color: rgb(168, 146, 78);
    border-bottom-color: rgb(168, 146, 78);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 16px;
}

.room-panel {
    flex-grow: 1;
    flex-direction: column;
}

.action-panel {
    width: 260px;
    margin-left: 18px;
    flex-direction: column;
}

.action-spacer {
    flex-grow: 1;
    min-height: 16px;
}

.panel-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.panel-head-right {
    flex-direction: row;
    align-items: center;
}

.panel-title {
    color: rgb(168, 146, 78);
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 8px;
}

.panel-head .panel-title {
    margin-bottom: 0;
}

.panel-meta {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 1px;
    margin-right: 10px;
}

/* ============================================================ room list */

.room-scroll {
    flex-grow: 1;
}

.room-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 6px;
    background-color: rgba(201, 179, 107, 0.06);
    border-left-width: 2px;
    border-left-color: rgb(78, 68, 40);
}

.room-item:hover {
    background-color: rgba(255, 246, 214, 0.10);
    border-left-color: rgb(168, 146, 78);
}

.room-item-left {
    flex-direction: column;
}

.room-item-code {
    color: rgb(255, 246, 214);
    font-size: 20px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.room-item-map {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 2px;
    margin-top: 3px;
}

.room-item-right {
    flex-direction: row;
    align-items: center;
}

.room-item-count {
    color: rgb(242, 231, 194);
    font-size: 14px;
    letter-spacing: 1px;
    margin-right: 12px;
}

.room-item-badge {
    color: rgb(14, 12, 8);
    background-color: rgb(168, 146, 78);
    font-size: 9px;
    letter-spacing: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 10px;
}

.room-item-badge-playing {
    background-color: rgb(214, 108, 96);
    color: rgb(24, 21, 14);
}

.room-item-badge-dev {
    background-color: rgb(120, 104, 58);
    color: rgb(242, 231, 194);
}

.room-item-join {
    margin-top: 0;
    flex-grow: 0;
    min-width: 74px;
}

.room-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.room-empty-title {
    color: rgb(168, 146, 78);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.room-empty-note {
    color: rgb(120, 104, 58);
    font-size: 11px;
    white-space: normal;
    max-width: 420px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ============================================================ buttons */

.button {
    background-color: rgba(201, 179, 107, 0.14);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(168, 146, 78);
    border-right-color: rgb(168, 146, 78);
    border-top-color: rgb(168, 146, 78);
    border-bottom-color: rgb(168, 146, 78);
    color: rgb(242, 231, 194);
    font-size: 13px;
    letter-spacing: 2px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-top: 8px;
    margin-left: 0;
    margin-right: 0;
}

.button:hover {
    background-color: rgba(255, 246, 214, 0.20);
}

.button:disabled {
    opacity: 0.35;
}

.button-primary {
    background-color: rgba(255, 246, 214, 0.22);
    -unity-font-style: bold;
}

.button-small {
    font-size: 11px;
    letter-spacing: 1px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-top: 0;
}

.button-danger {
    border-left-color: rgb(140, 74, 66);
    border-right-color: rgb(140, 74, 66);
    border-top-color: rgb(140, 74, 66);
    border-bottom-color: rgb(140, 74, 66);
    color: rgb(214, 108, 96);
}

/* ============================================================ fields */

.field-label {
    color: rgb(168, 146, 78);
    font-size: 10px;
    letter-spacing: 3px;
    margin-top: 10px;
    margin-bottom: 3px;
}

.field {
    margin-bottom: 2px;
}

.field .unity-base-text-field__input {
    background-color: rgba(201, 179, 107, 0.10);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(120, 104, 58);
    border-right-color: rgb(120, 104, 58);
    border-top-color: rgb(120, 104, 58);
    border-bottom-color: rgb(120, 104, 58);
    color: rgb(242, 231, 194);
    font-size: 14px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}

/* 코드는 받아 적는 값이다. 크게, 자간을 넓게, 대문자로. */
.field-code .unity-base-text-field__input {
    font-size: 22px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hint {
    color: rgb(183, 172, 126);
    font-size: 11px;
    white-space: normal;
    margin-top: 4px;
}

.row {
    flex-direction: row;
    margin-top: 8px;
}

.row .button {
    flex-grow: 1;
    margin-right: 6px;
}

/* ============================================================ status */

.status {
    margin-top: 14px;
    border-top-width: 1px;
    border-top-color: rgb(78, 68, 40);
    padding-top: 10px;
    flex-direction: column;
}

.status-line {
    color: rgb(242, 231, 194);
    font-size: 12px;
    white-space: normal;
}

/* 실패했을 때 다음에 할 일. 사유만 보여 주면 화면이 막힌다. */
.status-action {
    color: rgb(168, 146, 78);
    font-size: 11px;
    white-space: normal;
    margin-top: 3px;
}

.status-failed .status-line {
    color: rgb(214, 108, 96);
}

/* ============================================================ 페이지

   로비와 대기방. 한 번에 하나만 보이고, 그 판정은 `LobbyUIController.ShowRoomPage` 하나가
   갖는다. 둘 다 `flex-grow: 1` 이지만 감춰진 쪽은 `display: none` 이라 자리를 먹지 않는다.
*/

.page {
    flex-grow: 1;
    flex-direction: column;
}

/* ============================================================ 대기방 */

.room-page {
    flex-grow: 1;
    flex-direction: column;
    margin-top: 18px;
}

.room-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.room-head-left {
    flex-direction: column;
    align-items: flex-start;
}

/* 방 정보는 오른쪽 끝에 모은다. 코드가 화면의 주인공이고 이쪽은 확인용이다. */
.room-head-right {
    flex-direction: column;
    align-items: flex-end;
}

/*
    페이지의 코드는 왼쪽에 붙인다. 팝업에서는 프레임 폭 안에서 가운데였고, 여기서는
    화면 폭 전체가 배경이라 가운데 정렬이 코드를 허공에 띄운다.
*/
.room-head .room-code {
    -unity-text-align: middle-left;
    margin-bottom: 4px;
}

.room-body {
    flex-grow: 1;
    flex-direction: row;
}

.room-roster-panel {
    flex-grow: 1;
    flex-direction: column;
}

.room-actions {
    width: 260px;
    margin-left: 18px;
    flex-direction: column;
}

/*
    페이지에는 높이가 있으므로 명단이 정원 전체를 그린다. 팝업의 `max-height: 84%` 아래에서
    8칸을 그리면 아래의 시작 버튼이 잘렸고, 그래서 "모자란 만큼만 그리기" 라는 규칙이 따로
    있었다 — 그 타협이 없어진 자리가 이 한 줄이다.
*/
.roster-grow {
    flex-grow: 1;
}

.room-character-panel {
    width: 300px;
    margin-left: 18px;
    flex-direction: column;
}

/*
    미리보기. 배경 이미지는 런타임에 만든 렌더 텍스처이며(`CharacterPreview`), 카메라가
    매 프레임 스스로 그리므로 idle 이 여기서 움직인다.
*/
.character-preview {
    height: 210px;
    margin-top: 6px;
    margin-bottom: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(78, 68, 40);
    border-right-color: rgb(78, 68, 40);
    border-top-color: rgb(78, 68, 40);
    border-bottom-color: rgb(78, 68, 40);
    background-color: rgb(14, 12, 8);
}

.character-list {
    flex-grow: 1;
}

.character-item {
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0);
}

.character-item:hover {
    background-color: rgba(201, 179, 107, 0.08);
    border-left-color: rgb(168, 146, 78);
}

/* 지금 입고 있는 것. 목록에서 자기 줄을 세어 찾게 하지 않는다. */
.character-item-mine {
    border-left-color: rgb(255, 246, 214);
    background-color: rgba(201, 179, 107, 0.12);
}

/* 남이 입은 것은 감추지 않고 흐리게 둔다. 감추면 8종 중 몇 종인지 알 수 없다. */
.character-item-taken {
    opacity: 0.42;
}

/* 색 조각이 이름보다 먼저 말한다. */
.character-chip {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.character-name {
    flex-grow: 1;
    color: rgb(242, 231, 194);
    font-size: 12px;
    letter-spacing: 1px;
}

.character-state {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 1px;
}

/* 명단의 캐릭터 이름. 이름과 꼬리표 사이에 조용히 앉는다. */
.roster-character {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 1px;
    margin-right: 12px;
}

/*
    준비 도장. 색으로 먼저 말한다 — 여덟 줄에서 준비한 사람을 글자로 세게 하면 안 된다.
    준비하지 않은 줄은 글자가 없고 자리만 남는다(줄이 흔들리지 않게).
*/
.roster-ready {
    width: 58px;
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-right;
    color: rgb(112, 100, 62);
}

.roster-ready-on {
    color: rgb(255, 246, 214);
    -unity-font-style: bold;
}

/*
    이름이 남는 폭을 먹는다. 그러지 않으면 `space-between` 이 세 요소를 양 끝과 가운데로
    벌려 꼬리표가 줄 중앙에 떠 버린다.
*/
.room-page .roster-name {
    flex-grow: 1;
}

/* 방장에게만 보이는 줄별 버튼. 이름 쪽으로 새지 않게 오른쪽 끝에 모은다. */
.roster-actions {
    flex-direction: row;
    margin-left: 10px;
}

.roster-actions .button {
    margin-left: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* 페이지의 명단은 줄 사이를 벌린다. 팝업에서는 높이를 아끼려고 붙여 놓았다. */
.room-page .roster-row {
    margin-top: 6px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(78, 68, 40, 0.5);
}

/* ============================================================ popups */

.popup-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.popup-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(14, 12, 8, 0.78);
    align-items: center;
    justify-content: center;
}

.popup-frame {
    width: 460px;
    max-height: 84%;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: rgb(24, 21, 14);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(168, 146, 78);
    border-right-color: rgb(168, 146, 78);
    border-top-color: rgb(168, 146, 78);
    border-bottom-color: rgb(168, 146, 78);
}

.popup-frame-wide {
    width: 560px;
}

.popup-title {
    color: rgb(255, 246, 214);
    font-size: 16px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.popup-sub {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 3px;
    margin-bottom: 14px;
}

.popup-body {
    color: rgb(242, 231, 194);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 8px;
}

/* ============================================================ room popup */

.room-code {
    color: rgb(255, 246, 214);
    font-size: 42px;
    letter-spacing: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgb(14, 12, 8);
    margin-top: 2px;
    margin-bottom: 6px;
}

/* 인원/정원을 명단 제목과 같은 줄의 반대쪽 끝에 둔다. */
.roster-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* 정원은 제목보다 밝다. 읽으러 오는 값은 이쪽이다. */
.roster-count {
    color: rgb(242, 231, 194);
    letter-spacing: 2px;
}

/* 정원이 찬 방은 색으로 먼저 말한다 — 줄을 세어 알게 하면 안 된다. */
.roster-count-full {
    color: rgb(214, 108, 96);
}

.roster {
    flex-direction: column;
    min-height: 110px;
    border-left-width: 1px;
    border-left-color: rgb(78, 68, 40);
    padding-left: 10px;
}

.roster-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 3px;
}

.roster-name {
    color: rgb(242, 231, 194);
    font-size: 13px;
}

.roster-tag {
    color: rgb(168, 146, 78);
    font-size: 10px;
    letter-spacing: 2px;
}

/* 빈 자리는 사람 이름과 같은 무게로 읽히면 안 된다. 자리가 있다는 사실만 말한다. */
.roster-empty .roster-name {
    color: rgb(112, 100, 62);
    font-size: 12px;
    -unity-font-style: italic;
}

/* 나 자신은 눈에 띄어야 한다. 8명 명단에서 자기 줄을 세어 찾게 하면 안 된다. */
.roster-self .roster-name {
    color: rgb(255, 246, 214);
    -unity-font-style: bold;
}

/* ============================================================ toast */

.toast-root {
    position: absolute;
    right: 28px;
    bottom: 28px;
    flex-direction: column;
    align-items: flex-end;
}

.toast {
    background-color: rgba(14, 12, 8, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(168, 146, 78);
    color: rgb(242, 231, 194);
    font-size: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-top: 6px;
    white-space: normal;
    max-width: 380px;
}

.toast-error {
    border-left-color: rgb(214, 108, 96);
    color: rgb(214, 108, 96);
}

/* ============================================================ loading */

.loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(14, 12, 8, 0.72);
    align-items: center;
    justify-content: center;
}

.loading-text {
    color: rgb(255, 246, 214);
    font-size: 14px;
    letter-spacing: 5px;
}

/* ============================================================ map list

   The create-room map list. Rows come from the server merged with this build's
   catalog, so a row can be listed and un-pickable — .map-item-blocked is that
   state and it keeps the reason readable rather than dimming it away. */

.map-list {
    max-height: 210px;
    margin-bottom: 10px;
    border-left-width: 2px;
    border-left-color: rgb(78, 68, 40);
}

.map-item {
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 4px;
    background-color: rgba(201, 179, 107, 0.06);
    border-left-width: 2px;
    border-left-color: rgba(78, 68, 40, 0);
}

.map-item:hover {
    background-color: rgba(255, 246, 214, 0.10);
}

.map-item-selected {
    background-color: rgba(255, 246, 214, 0.14);
    border-left-color: rgb(201, 179, 107);
}

.map-item-blocked {
    background-color: rgba(201, 179, 107, 0.03);
    border-left-color: rgb(120, 60, 48);
}

.map-item-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.map-item-name {
    color: rgb(255, 246, 214);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.map-item-meta {
    color: rgb(150, 132, 76);
    font-size: 10px;
    letter-spacing: 1px;
}

.map-item-description {
    color: rgb(150, 132, 76);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}

/* Not dimmed. This line is the whole reason the row is still on screen. */
.map-item-reason {
    color: rgb(214, 132, 106);
    font-size: 11px;
    margin-top: 3px;
    white-space: normal;
}

#create-map-loading {
    color: rgb(150, 132, 76);
    font-size: 12px;
    padding-left: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}
