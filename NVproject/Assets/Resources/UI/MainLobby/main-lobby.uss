/*
    Backrooms Escape — main lobby style.

    Same palette as game-hud.uss and the old lobby.uss, for the same reason: this is the first
    thing anyone sees, and if it reads as a game menu the level's mood restarts from zero when the
    match begins. Wall #C9B36B, trim #A8924E, fluorescent #FFF6D6, bone #F2E7C2, brown-black #0E0C08.

    Two rules carried over:
    - Nothing is pure white or pure black. Pure values read as software; these read as signage.
    - Panels are translucent, thin-bordered, square. Facility labelling, not a game overlay.

    One rule of its own: the invite code is *read aloud and typed by someone else*, so anywhere a
    code appears it is oversized and letter-spaced wide enough that no two characters run together.
*/

.lobby-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* WebGL 에는 OS 폰트 폴백이 없다 — 한글은 여기 실어 준 폰트가 전부다 (game-hud.uss 참고). */
    -unity-font-definition: url("../Fonts/NotoSansKR-Regular.otf");
    background-color: rgb(24, 21, 14);
    flex-direction: column;
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 28px;
    padding-bottom: 20px;
}

.bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(201, 179, 107, 0.03);
}

.scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.16;
    /* texture generated at runtime to match the screen height, so the lines stay one pixel */
}

/* ============================================================ header */

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom-width: 1px;
    border-bottom-color: rgb(78, 68, 40);
    padding-bottom: 14px;
}

.logo-title {
    color: rgb(255, 246, 214);
    font-size: 26px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    text-shadow: 2px 2px 0 rgb(14, 12, 8);
}

.logo-sub {
    color: rgb(168, 146, 78);
    font-size: 10px;
    letter-spacing: 4px;
    margin-top: 2px;
}

.header-right {
    flex-direction: row;
    align-items: flex-start;
}

.player-info-slot {
    margin-right: 22px;
}

/* ============================================================ player info */

.player-info {
    flex-direction: column;
    align-items: flex-end;
}

.player-name {
    color: rgb(242, 231, 194);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.player-note {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 2px;
    margin-top: 2px;
}

/* ============================================================ connection */

.connection {
    flex-direction: column;
    align-items: flex-end;
}

.connection-line {
    flex-direction: row;
    align-items: center;
}

.connection-dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    background-color: rgb(120, 104, 58);
}

.connection-label {
    color: rgb(242, 231, 194);
    font-size: 12px;
    letter-spacing: 2px;
}

.connection-meta {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 1px;
    margin-top: 3px;
}

.connection-online .connection-dot {
    background-color: rgb(150, 196, 120);
}

.connection-offline .connection-dot {
    background-color: rgb(214, 108, 96);
}

.connection-offline .connection-label {
    color: rgb(214, 108, 96);
}

/* ============================================================ content */

.content-grid {
    flex-grow: 1;
    flex-direction: row;
    margin-top: 18px;
}

/* 친구 · 파티가 들어올 자리. 비어 있는 동안 폭을 먹지 않는다. */
.side-rail {
    width: 0;
}

.panel {
    background-color: rgba(14, 12, 8, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(168, 146, 78);
    border-right-color: rgb(168, 146, 78);
    border-top-color: rgb(168, 146, 78);
    border-bottom-color: rgb(168, 146, 78);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 16px;
}

.room-panel {
    flex-grow: 1;
    flex-direction: column;
}

.action-panel {
    width: 260px;
    margin-left: 18px;
    flex-direction: column;
}

.action-spacer {
    flex-grow: 1;
    min-height: 16px;
}

.panel-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.panel-head-right {
    flex-direction: row;
    align-items: center;
}

.panel-title {
    color: rgb(168, 146, 78);
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 8px;
}

.panel-head .panel-title {
    margin-bottom: 0;
}

.panel-meta {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 1px;
    margin-right: 10px;
}

/* ============================================================ room list */

.room-scroll {
    flex-grow: 1;
}

.room-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 6px;
    background-color: rgba(201, 179, 107, 0.06);
    border-left-width: 2px;
    border-left-color: rgb(78, 68, 40);
}

.room-item:hover {
    background-color: rgba(255, 246, 214, 0.10);
    border-left-color: rgb(168, 146, 78);
}

.room-item-left {
    flex-direction: column;
}

.room-item-code {
    color: rgb(255, 246, 214);
    font-size: 20px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.room-item-map {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 2px;
    margin-top: 3px;
}

.room-item-right {
    flex-direction: row;
    align-items: center;
}

.room-item-count {
    color: rgb(242, 231, 194);
    font-size: 14px;
    letter-spacing: 1px;
    margin-right: 12px;
}

.room-item-badge {
    color: rgb(14, 12, 8);
    background-color: rgb(168, 146, 78);
    font-size: 9px;
    letter-spacing: 2px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 10px;
}

.room-item-badge-playing {
    background-color: rgb(214, 108, 96);
    color: rgb(24, 21, 14);
}

.room-item-badge-dev {
    background-color: rgb(120, 104, 58);
    color: rgb(242, 231, 194);
}

.room-item-join {
    margin-top: 0;
    flex-grow: 0;
    min-width: 74px;
}

.room-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.room-empty-title {
    color: rgb(168, 146, 78);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.room-empty-note {
    color: rgb(120, 104, 58);
    font-size: 11px;
    white-space: normal;
    max-width: 420px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ============================================================ buttons */

.button {
    background-color: rgba(201, 179, 107, 0.14);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(168, 146, 78);
    border-right-color: rgb(168, 146, 78);
    border-top-color: rgb(168, 146, 78);
    border-bottom-color: rgb(168, 146, 78);
    color: rgb(242, 231, 194);
    font-size: 13px;
    letter-spacing: 2px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-top: 8px;
    margin-left: 0;
    margin-right: 0;
}

.button:hover {
    background-color: rgba(255, 246, 214, 0.20);
}

.button:disabled {
    opacity: 0.35;
}

.button-primary {
    background-color: rgba(255, 246, 214, 0.22);
    -unity-font-style: bold;
}

.button-small {
    font-size: 11px;
    letter-spacing: 1px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-top: 0;
}

.button-danger {
    border-left-color: rgb(140, 74, 66);
    border-right-color: rgb(140, 74, 66);
    border-top-color: rgb(140, 74, 66);
    border-bottom-color: rgb(140, 74, 66);
    color: rgb(214, 108, 96);
}

/* ============================================================ fields */

.field-label {
    color: rgb(168, 146, 78);
    font-size: 10px;
    letter-spacing: 3px;
    margin-top: 10px;
    margin-bottom: 3px;
}

.field {
    margin-bottom: 2px;
}

.field .unity-base-text-field__input {
    background-color: rgba(201, 179, 107, 0.10);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(120, 104, 58);
    border-right-color: rgb(120, 104, 58);
    border-top-color: rgb(120, 104, 58);
    border-bottom-color: rgb(120, 104, 58);
    color: rgb(242, 231, 194);
    font-size: 14px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}

/* 코드는 받아 적는 값이다. 크게, 자간을 넓게, 대문자로. */
.field-code .unity-base-text-field__input {
    font-size: 22px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Toggle 은 라벨과 체크박스 색을 런타임 기본 테마에서 받는다 — 검정 글자라
   어두운 팝업 위에서는 라벨이 아예 보이지 않는다. 팝업 본문과 입력 필드의
   팔레트로 맞춘다. 방 만들기의 공개 토글과 설정의 HTTPS 토글이 이 규칙을 쓴다. */
.unity-toggle .unity-toggle__label {
    color: rgb(242, 231, 194);
    font-size: 13px;
    min-width: auto;
}

.unity-toggle .unity-toggle__checkmark {
    background-color: rgba(201, 179, 107, 0.10);
    border-left-color: rgb(120, 104, 58);
    border-right-color: rgb(120, 104, 58);
    border-top-color: rgb(120, 104, 58);
    border-bottom-color: rgb(120, 104, 58);
    -unity-background-image-tint-color: rgb(255, 246, 214);
}

.hint {
    color: rgb(183, 172, 126);
    font-size: 11px;
    white-space: normal;
    margin-top: 4px;
}

.row {
    flex-direction: row;
    margin-top: 8px;
}

.row .button {
    flex-grow: 1;
    margin-right: 6px;
}

/* ============================================================ status */

.status {
    margin-top: 14px;
    border-top-width: 1px;
    border-top-color: rgb(78, 68, 40);
    padding-top: 10px;
    flex-direction: column;
}

.status-line {
    color: rgb(242, 231, 194);
    font-size: 12px;
    white-space: normal;
}

/* 실패했을 때 다음에 할 일. 사유만 보여 주면 화면이 막힌다. */
.status-action {
    color: rgb(168, 146, 78);
    font-size: 11px;
    white-space: normal;
    margin-top: 3px;
}

.status-failed .status-line {
    color: rgb(214, 108, 96);
}

/* ============================================================ popups */

.popup-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.popup-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(14, 12, 8, 0.78);
    align-items: center;
    justify-content: center;
}

.popup-frame {
    width: 460px;
    max-height: 84%;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 24px;
    padding-bottom: 24px;
    background-color: rgb(24, 21, 14);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(168, 146, 78);
    border-right-color: rgb(168, 146, 78);
    border-top-color: rgb(168, 146, 78);
    border-bottom-color: rgb(168, 146, 78);
}

.popup-title {
    color: rgb(255, 246, 214);
    font-size: 16px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.popup-sub {
    color: rgb(120, 104, 58);
    font-size: 10px;
    letter-spacing: 3px;
    margin-bottom: 14px;
}

.popup-body {
    color: rgb(242, 231, 194);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 8px;
}

/* ============================================================ toast */

.toast-root {
    position: absolute;
    right: 28px;
    bottom: 28px;
    flex-direction: column;
    align-items: flex-end;
}

.toast {
    background-color: rgba(14, 12, 8, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(168, 146, 78);
    color: rgb(242, 231, 194);
    font-size: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-top: 6px;
    white-space: normal;
    max-width: 380px;
}

.toast-error {
    border-left-color: rgb(214, 108, 96);
    color: rgb(214, 108, 96);
}

/* ============================================================ loading */

.loading-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(14, 12, 8, 0.72);
    align-items: center;
    justify-content: center;
}

.loading-text {
    color: rgb(255, 246, 214);
    font-size: 14px;
    letter-spacing: 5px;
}

/* ============================================================ map list

   The create-room map list. Rows come from the server merged with this build's
   catalog, so a row can be listed and un-pickable — .map-item-blocked is that
   state and it keeps the reason readable rather than dimming it away. */

.map-list {
    max-height: 210px;
    margin-bottom: 10px;
    border-left-width: 2px;
    border-left-color: rgb(78, 68, 40);
}

.map-item {
    flex-direction: column;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 4px;
    background-color: rgba(201, 179, 107, 0.06);
    border-left-width: 2px;
    border-left-color: rgba(78, 68, 40, 0);
}

.map-item:hover {
    background-color: rgba(255, 246, 214, 0.10);
}

.map-item-selected {
    background-color: rgba(255, 246, 214, 0.14);
    border-left-color: rgb(201, 179, 107);
}

.map-item-blocked {
    background-color: rgba(201, 179, 107, 0.03);
    border-left-color: rgb(120, 60, 48);
}

.map-item-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.map-item-name {
    color: rgb(255, 246, 214);
    font-size: 14px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.map-item-meta {
    color: rgb(150, 132, 76);
    font-size: 10px;
    letter-spacing: 1px;
}

.map-item-description {
    color: rgb(150, 132, 76);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}

/* Not dimmed. This line is the whole reason the row is still on screen. */
.map-item-reason {
    color: rgb(214, 132, 106);
    font-size: 11px;
    margin-top: 3px;
    white-space: normal;
}

#create-map-loading {
    color: rgb(150, 132, 76);
    font-size: 12px;
    padding-left: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}
