/*
    Backrooms Escape — HUD style.

    The palette is the level's, not a UI palette: wall #C9B36B, trim #A8924E, ceiling #D8CFA8,
    fluorescent #FFF6D6, fog #B7AC7E. Anything that is not those colours has to earn it, and only
    two things do — the alert red of a wound, and the sick green of a door that has opened.

    Two rules the mood depends on:
    - Nothing is pure white and nothing is pure black. The brightest ink here is bone (#F2E7C2)
      and the darkest is a brown-black (#0E0C08). Pure values read as software; these read as
      signage under a failing tube.
    - Panels are translucent, thin-bordered, and square. This is facility labelling, not a game
      overlay — no rounded cards, no drop shadows, no gradients.

    Legibility still wins over atmosphere: the walls in this level are pale yellow, so every piece
    of text carries a dark text-shadow, exactly like the crosshair carries a black outline.
*/

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ============================================================ atmosphere */

.scanlines {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.16;
    /* texture generated at runtime to match the screen height, so the lines stay one pixel */
}

/*
   쓰러진 뒤의 무채색 막.

   회색의 밝기가 이 방의 중간 밝기에 맞춰져 있다. 더 밝으면 안개가 낀 것처럼, 더 어두우면
   그냥 화면이 꺼지는 것처럼 보인다 — 목표는 밝기가 아니라 **색이 빠지는 것**이다.
*/
.dead-wash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgb(84, 82, 78);
}

/*
    관전 띠. 화면 아래 가운데.

    `display` 로 껐다 켠다 — 관전은 죽어 있는 동안만이고, 그 사이 다른 HUD 는 그대로 살아
    있어야 하므로 트리에서 빼지 않는다.
*/
.spectator-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.spectator-tag {
    font-size: 11px;
    letter-spacing: 2px;
    color: rgb(150, 146, 136);
    margin-right: 8px;
}

.spectator-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(232, 228, 216);
    margin-right: 12px;
}

.spectator-hint {
    font-size: 11px;
    color: rgb(122, 118, 110);
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    -unity-background-image-tint-color: rgb(150, 30, 26);
}

/* ============================================================ shared bar */

.shared-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 22px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    padding-left: 40px;
    padding-right: 40px;
}

.clock-block {
    align-items: center;
    flex-grow: 1;
}

.clock {
    font-size: 46px;
    color: rgb(242, 231, 194);
    -unity-font-style: bold;
    letter-spacing: 6px;
    text-shadow: 0 2px 6px rgba(14, 12, 8, 0.9);
}

.clock--urgent {
    color: rgb(226, 106, 92);
}

.clock__caption {
    font-size: 11px;
    letter-spacing: 4px;
    color: rgba(215, 200, 152, 0.62);
    margin-top: -2px;
}

.chip {
    background-color: rgba(14, 12, 8, 0.55);
    border-left-width: 2px;
    border-left-color: rgb(168, 146, 78);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(168, 146, 78, 0.35);
    border-right-color: rgba(168, 146, 78, 0.35);
    border-bottom-color: rgba(168, 146, 78, 0.35);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    min-width: 190px;
}

.chip__text {
    font-size: 15px;
    letter-spacing: 3px;
    color: rgb(242, 231, 194);
    -unity-font-style: bold;
    text-shadow: 0 1px 3px rgba(14, 12, 8, 0.9);
}

.chip--seeker {
    border-left-color: rgb(226, 128, 74);
}

.chip--runner {
    border-left-color: rgb(150, 196, 214);
}

/* ============================================================ notices */

.notice {
    position: absolute;
    left: 0;
    right: 0;
    top: 118px;
    font-size: 19px;
    letter-spacing: 4px;
    color: rgb(255, 217, 138);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(14, 12, 8, 0.95);
    opacity: 0;
}

.prompt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 168px;
    font-size: 18px;
    letter-spacing: 3px;
    color: rgb(242, 231, 194);
    -unity-text-align: middle-center;
    text-shadow: 0 1px 4px rgba(14, 12, 8, 0.95);
}

/* ============================================================ role panels */

.role-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.panel {
    position: absolute;
    background-color: rgba(14, 12, 8, 0.5);
    border-width: 1px;
    border-color: rgba(168, 146, 78, 0.4);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.panel--bottom-left {
    left: 40px;
    bottom: 46px;
    min-width: 300px;
}

.panel--bottom-right {
    right: 40px;
    bottom: 46px;
    align-items: flex-end;
    min-width: 210px;
}

.panel--right {
    right: 40px;
    bottom: 190px;
    align-items: flex-end;
    min-width: 210px;
}

.panel__caption {
    font-size: 11px;
    letter-spacing: 4px;
    color: rgba(215, 200, 152, 0.6);
    margin-bottom: 6px;
}

.panel__line {
    font-size: 14px;
    letter-spacing: 2px;
    color: rgb(242, 231, 194);
    margin-top: 6px;
    text-shadow: 0 1px 3px rgba(14, 12, 8, 0.9);
}

.panel__line--alert {
    color: rgb(226, 106, 92);
}

.panel__line--sense {
    color: rgb(226, 128, 74);
}

/* ============================================================ slots and pips */

.slot-row {
    flex-direction: row;
}

.slot-row--centred {
    justify-content: center;
}

.slot {
    width: 20px;
    height: 24px;
    margin-right: 5px;
    border-width: 1px;
    border-color: rgba(201, 179, 107, 0.55);
    background-color: rgba(20, 18, 12, 0.5);
}

.slot--filled {
    background-color: rgb(255, 217, 138);
    border-color: rgb(255, 246, 214);
}

/* a key in hand is not a key in the door — it reads as pending, not as progress */
.slot--carried {
    background-color: rgba(255, 217, 138, 0.28);
    border-color: rgb(255, 217, 138);
}

.pip {
    width: 26px;
    height: 12px;
    margin-left: 5px;
    border-width: 1px;
    border-color: rgba(201, 179, 107, 0.55);
    background-color: rgba(20, 18, 12, 0.5);
}

.pip--full {
    background-color: rgb(226, 218, 182);
    border-color: rgb(255, 246, 214);
}

.pip--hurt {
    background-color: rgb(150, 30, 26);
    border-color: rgb(226, 106, 92);
}

.shell {
    width: 16px;
    height: 34px;
    margin-left: 6px;
    border-width: 1px;
    border-color: rgba(201, 179, 107, 0.55);
    background-color: rgba(20, 18, 12, 0.5);
}

.shell--loaded {
    background-color: rgb(226, 128, 74);
    border-color: rgb(255, 217, 138);
}

/* ============================================================ runner: door compass */

.compass {
    position: absolute;
    width: 74px;
    height: 74px;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.compass__arrow {
    font-size: 30px;
    color: rgb(140, 226, 150);
    text-shadow: 0 0 10px rgba(60, 150, 70, 0.9);
}

.compass__distance {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(200, 232, 200);
    text-shadow: 0 1px 3px rgba(14, 12, 8, 0.95);
}

/* ============================================================ seeker: destroy meter + chain */

.destroy {
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    align-items: center;
    opacity: 0;
}

.chain {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    align-items: center;
    opacity: 0;
}

.chain__title {
    font-size: 44px;
    letter-spacing: 12px;
    color: rgb(226, 106, 92);
    -unity-font-style: bold;
    text-shadow: 0 2px 10px rgba(14, 12, 8, 0.95);
}

.chain__line {
    font-size: 16px;
    letter-spacing: 4px;
    color: rgb(242, 231, 194);
    text-shadow: 0 1px 4px rgba(14, 12, 8, 0.95);
}

/* ============================================================ device overlays */

/*
    Overlays are a full-screen holder plus a frame inside it. Centring with a percentage translate
    would have been shorter, but a holder that flexes its child into place cannot be thrown off by
    an aspect ratio, and the same structure parks the camera feed in a corner without a second rule
    for it.
*/
.overlay-holder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.overlay-holder--centre {
    align-items: center;
    justify-content: center;
}

.overlay-holder--corner {
    align-items: flex-end;
    justify-content: flex-start;
    padding-top: 120px;
    padding-right: 40px;
}

.frame {
    background-color: rgba(10, 9, 6, 0.86);
    border-width: 1px;
    border-color: rgba(168, 146, 78, 0.55);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    align-items: center;
}

.overlay__title {
    font-size: 12px;
    letter-spacing: 5px;
    color: rgb(255, 217, 138);
    margin-bottom: 6px;
}

.overlay__image {
    width: 640px;
    height: 320px;
    background-color: rgb(18, 16, 11);
}

.overlay__image--crt {
    width: 420px;
    height: 236px;
    -unity-background-image-tint-color: rgb(226, 218, 190);
}

.overlay__caption {
    font-size: 12px;
    letter-spacing: 3px;
    color: rgba(215, 200, 152, 0.75);
    margin-top: 6px;
}

.effect-list {
    align-items: flex-end;
}

.effect {
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(255, 217, 138);
    margin-top: 4px;
    text-shadow: 0 1px 3px rgba(14, 12, 8, 0.9);
}

/* ============================================================ freeze banner */

.freeze {
    position: absolute;
    left: 0;
    right: 0;
    top: 30%;
    align-items: center;
    opacity: 0;
}

.freeze__title {
    font-size: 56px;
    letter-spacing: 18px;
    color: rgb(214, 240, 250);
    -unity-font-style: bold;
    text-shadow: 0 0 22px rgba(120, 190, 220, 0.85);
}

.freeze__line {
    font-size: 15px;
    letter-spacing: 8px;
    color: rgba(214, 240, 250, 0.8);
}

/* ============================================================ full-screen cards */

.card {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 9, 6, 0.72);
    display: none;
}

.card__button {
    margin-top: 26px;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 15px;
    letter-spacing: 2px;
    color: rgb(232, 228, 216);
    background-color: rgba(120, 110, 78, 0.35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(150, 140, 104);
    border-right-color: rgb(150, 140, 104);
    border-top-color: rgb(150, 140, 104);
    border-bottom-color: rgb(150, 140, 104);
}

.card__button:hover {
    background-color: rgba(150, 140, 104, 0.55);
}

.card__title {
    font-size: 76px;
    letter-spacing: 26px;
    color: rgb(242, 231, 194);
    -unity-font-style: bold;
    text-shadow: 0 0 26px rgba(255, 246, 214, 0.35);
}

.card__title--seeker {
    color: rgb(232, 138, 82);
}

.card__title--runner {
    color: rgb(178, 214, 228);
}

.card__title--win {
    color: rgb(150, 226, 160);
}

.card__title--lose {
    color: rgb(226, 106, 92);
}

.card__flavor {
    font-size: 18px;
    letter-spacing: 5px;
    color: rgba(215, 200, 152, 0.85);
    margin-top: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 900px;
}

.card__count {
    font-size: 13px;
    letter-spacing: 6px;
    color: rgba(215, 200, 152, 0.5);
    margin-top: 26px;
}
