<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- The in-game HUD's stylesheet first, so the lobby is unmistakably the same interface. -->
    <Style src="project://database/Assets/Resources/UI/game-hud.uss" />
    <Style src="project://database/Assets/Resources/UI/lobby.uss" />

    <ui:VisualElement name="lobby-root" class="hud-root">
        <ui:VisualElement name="scanlines" class="scanlines" picking-mode="Ignore" />

        <!-- ============================================================ header -->
        <ui:VisualElement name="header" class="lobby-header" picking-mode="Ignore">
            <ui:Label name="room-title" text="STAGING ROOM — SUBLEVEL 0" class="lobby-title" />
            <ui:Label name="room-subtitle" text="WAIT HERE" class="clock__caption" />
        </ui:VisualElement>

        <ui:Label name="notice" text="" class="notice" picking-mode="Ignore" />

        <!-- ============================================================ roster -->
        <ui:VisualElement name="roster-panel" class="panel lobby-roster" picking-mode="Ignore">
            <ui:Label name="roster-caption" text="IN THE ROOM" class="panel__caption" />
            <ui:VisualElement name="roster" class="lobby-roster__list" picking-mode="Ignore" />
            <ui:Label name="roster-count" text="0 / 6" class="panel__line" />
        </ui:VisualElement>

        <!-- ============================================================ customisation -->
        <ui:VisualElement name="customization-panel" class="panel lobby-customization">
            <ui:Label name="customization-caption" text="PICK A CHARACTER  ·  ONE EACH" class="panel__caption" />
            <ui:VisualElement name="customization" class="lobby-customization__list" />
        </ui:VisualElement>

        <!-- ============================================================ countdown -->
        <ui:VisualElement name="countdown-block" class="lobby-countdown" picking-mode="Ignore">
            <ui:Label name="countdown" text="" class="lobby-countdown__value" />
            <ui:Label name="countdown-caption" text="" class="lobby-countdown__caption" />
        </ui:VisualElement>

        <!-- ============================================================ actions -->
        <ui:VisualElement name="action-bar" class="lobby-actions">
            <ui:Button name="ready-button" text="READY" class="lobby-button" />
            <ui:Label name="hint" text="CLICK AN EMPTY STAND TO MOVE  ·  CLICK SOMEONE TO ASK FOR THEIR SPOT"
                      class="lobby-hint" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ============================================================ swap request -->
        <ui:VisualElement name="swap-prompt" class="lobby-swap">
            <ui:Label name="swap-text" text="" class="lobby-swap__text" picking-mode="Ignore" />
            <ui:VisualElement name="swap-buttons" class="lobby-swap__buttons">
                <ui:Button name="swap-accept" text="TRADE" class="lobby-button lobby-button--small" />
                <ui:Button name="swap-decline" text="NO" class="lobby-button lobby-button--small lobby-button--quiet" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
