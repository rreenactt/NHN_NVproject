<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="escape-menu.uss" />

    <!-- Unlike the HUD, this tree CATCHES clicks: the backdrop is the click shield that keeps a
         stray press from reaching the world while the menu is up. -->
    <ui:VisualElement name="esc-root" class="esc-root">
        <ui:VisualElement name="esc-panel" class="esc-panel">
            <ui:Label name="esc-title" class="esc-title" text="SYSTEM" />
            <ui:VisualElement class="esc-rule" />

            <ui:Button name="esc-resume" class="esc-button" text="계속한다" />
            <ui:Button name="esc-help" class="esc-button" text="게임 방법" />
            <ui:Button name="esc-return" class="esc-button" text="대기방으로 되돌린다" />
            <ui:Button name="esc-leave" class="esc-button esc-button--danger" text="방에서 나간다" />
            <ui:Button name="esc-quit" class="esc-button esc-button--danger" text="게임을 종료한다" />

            <ui:Label name="esc-hint" class="esc-hint" text="ESC — 닫기" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
