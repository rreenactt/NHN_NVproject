# /opt/nvserver/shared/nvserver.env — systemd EnvironmentFile. 소유 nvserver, chmod 600.
# 앱 설정의 단일 출처다. GitHub Secrets 에는 앱 설정을 두지 않는다 (deploy-plan.md 2절).
# deploy.sh 부트스트랩이 이 예시를 처음 한 번 복사하고, 이후에는 절대 덮어쓰지 않는다.

ASPNETCORE_ENVIRONMENT=Production

# Kestrel 은 루프백에만 바인딩한다 — 밖은 Caddy(:443)가 받는다.
# deploy.sh 와 nvserver-healthcheck.sh 의 HEALTH_URL 과 짝이다. 포트를 바꾸면 셋을 같이 바꾼다.
ASPNETCORE_URLS=http://127.0.0.1:5202

# 전달 헤더. 이 스위치의 기본 신뢰 목록이 루프백뿐이라, 같은 머신의 Caddy 가 붙인
# X-Forwarded-For 만 믿고 외부에서 위조해 온 것은 믿지 않는다.
# 없으면 요청 제한(RateLimit:*)이 프록시 IP 하나로 묶인다 — docs/readme.md 의 경고.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# CORS 허용 오리진은 여기 두지 않는다 — Api/appsettings.Production.json 이 단일 출처다.
# 여기에 Cors__AllowedOrigins__0 을 쓰면 환경변수가 그 파일을 덮어쓴다.
