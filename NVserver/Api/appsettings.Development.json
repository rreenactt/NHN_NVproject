{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Game": {
    "Maps": {
      "default": "../MapData/backrooms.json",
      "test-room": "../MapData/test-room.json"
    },
    "StaticRooms": {
      "test": "test-room"
    },

    // 내보낸 맵마다 `test-{맵 id}` 룸이 자동으로 열린다. 위의 `test` 가 여는
    // `test-room` 은 건너뛰므로, 지금은 backrooms 계열이 이것으로 열린다.
    "TestRoomsPerMap": true
  },
  "Realtime": {
    "NetworkConditionsEnabled": false,
    "LatencyMilliseconds": 120,
    "JitterMilliseconds": 30,
    "PacketLoss": 0.02,

    // 정적 룸(`test`)에 봇을 채워 사람 한 명으로 매치를 돌린다.
    // `Role` 은 봇이 맡을 역할이므로 `Runner` 면 사람이 술래다 — 총을 확인하려면 그쪽이다.
    "Bots": {
      "Enabled": true,
      "FillTo": 2,
      "Role": "Runner"
    }
  }
}
