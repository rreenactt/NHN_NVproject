{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Game": {
    "Maps": {
      "default": "../MapData/backrooms.json",
      "test-room": "../MapData/test-room.json"
    },
    "StaticRooms": {
      "test": "test-room"
    }
  },
  "Realtime": {
    "NetworkConditionsEnabled": false,
    "LatencyMilliseconds": 0,
    "JitterMilliseconds": 0,
    "PacketLoss": 0.0,

    // 봇 참가자는 개발 전용이다. 여기서 켜면 기동이 멈춘다 —
    // `ModuleRegistration.GuardDevelopmentOnlyOptions` 가 개발 환경 밖에서 거부한다.
    "Bots": {
      "Enabled": false
    }
  }
}
