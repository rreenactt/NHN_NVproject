{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Game": {
    // 이 디렉터리의 `*.json` 전부가 등록된 맵이다. 맵 id 는 파일명이고 파일 안의
    // `name` 과 같아야 한다 — 다르면 기동이 멈춘다. 맵을 추가하려면 Unity 의
    // Tools ▸ NV ▸ Map ▸ Export Map Collision 으로 여기에 파일을 쓰면 된다.
    "MapDirectory": "../MapData",

    // 별칭이다. 등록이 아니다 — 값은 위 디렉터리에 있는 맵의 id 다.
    // `default` 는 맵을 지정하지 않은 요청과 `StaticRooms` 가 쓰므로 반드시 있어야 한다.
    "Maps": {
      "default": "backrooms"
    }

    // `StaticRooms` 와 `TestRoomsPerMap` 은 여기 없고 appsettings.Development.json 에 있다.
    // 이 파일은 배포에도 상속되므로, 여기 적은 정적 룸은 운영 서버에 방장 없고 만료되지
    // 않는 공개 방을 연다 — 실제로 `test` 룸이 그렇게 배포까지 따라갔다. 개발 환경 밖에서
    // 설정돼 있으면 기동이 거부된다 (ModuleRegistration.LoadStaticRooms).
  },
  "Realtime": {
    "NetworkConditionsEnabled": false,
    "LatencyMilliseconds": 0,
    "JitterMilliseconds": 0,
    "PacketLoss": 0.0,

    // 봇 참가자는 개발 전용이다. 여기서 켜면 기동이 멈춘다 —
    // `ModuleRegistration.GuardDevelopmentOnlyOptions` 가 개발 환경 밖에서 거부한다.
    "Bots": {
      "Enabled": false
    }
  }
}
